{
  "name": "@strongnguyen/nestjs-apm",
  "version": "2.0.0",
  "description": "NestJs Elastic APM Module",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "lint": "eslint lib --max-warnings 0",
    "lint:fix": "eslint lib --fix",
    "test": "jest",
    "test:cov": "jest --coverage",
    "format": "prettier --write \"lib/**/*.ts\"",
    "prepare": "husky install",
    "publish:npm": "npm run build && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strongnguyen29/nestjs-apm"
  },
  "keywords": [
    "NestJS",
    "Elastic",
    "APM"
  ],
  "author": "StrongNguyen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/strongnguyen29/nestjs-apm/issues"
  },
  "homepage": "https://github.com/strongnguyen29/nestjs-apm#readme",
  "dependencies": {
    "elastic-apm-node": "^3.37.0"
  },
  "devDependencies": {
    "@nestjs/common": "^9.0.6",
    "@nestjs/core": "^9.0.6",
    "@types/node": "^20.19.41",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^3.8.3",
    "rimraf": "^5.0.10",
    "rxjs": "^7.5.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
